# Telegram (required)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# Filters
MIN_TVL_BCH=0.05 # set to 0 if you dont want to have a minimum TVL.
MIN_TRADE_BCH=0.01 # set to 0 if you dont want to have a minimum for amount in BCH traded.
# Riften's TVL counts the BCH side twice. Set false to use the raw BCH side.
TVL_DOUBLE_BCH_SIDE=true

# Top-TVL tokens to watch. Unset or 0 = all tokens (Rostrum limits subscriptions per connection)
# MAX_TOKENS=200
MAX_CONNECTIONS=4
TOKENS_PER_CONNECTION=0

# Trade size tiers (BCH)
BIG_TRADE_BCH=1
WHALE_TRADE_BCH=5

# BCH price in USD, used only if no live price source has ever worked
# BCH_USD_FALLBACK=450

# Extras (defaults shown)
# REFRESH_MS=300000
# DEBUG=1
# LOG_FILE=data/trades.jsonl

# Endpoints (defaults shown)
# INDEXER_URL=https://indexer.riften.net/cauldron
# ROSTRUM_URL=wss://rostrum.riften.net:443
# BCMR_URL=https://bcmr.paytaca.com/api/tokens
# EXPLORER_TX_URL=https://bchexplorer.info/tx/{txid}
# TOKEN_URL=https://app.cauldron.quest/swap/{id}
